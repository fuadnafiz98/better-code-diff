{
  "name": "better-code-diff",
  "version": "0.1.0",
  "description": "A diff-first Git explorer for macOS.",
  "author": "Better Code Diff Contributors",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/run-electron-vite.sh",
    "dev:background": "BETTER_CODE_DIFF_BACKGROUND=1 bash scripts/run-electron-vite.sh",
    "build": "electron-vite build",
    "icon:mac": "bash scripts/generate-macos-icon.sh",
    "dist:mac": "bun run icon:mac && bun run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --arm64",
    "install:mac": "bash scripts/install-macos-app.sh",
    "update:mac": "bun run dist:mac && bun run install:mac",
    "open:mac": "open -a \"Better Code Diff\"",
    "update:mac:open": "bun run update:mac && bun run open:mac",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "bun test",
    "perf:snapshot": "bash scripts/benchmark-memory.sh"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pierre/diffs": "1.3.5",
    "@pierre/icons": "0.7.1",
    "@pierre/theme": "1.1.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@vscode/ripgrep": "1.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.3",
    "vite": "7.3.6"
  },
  "packageManager": "bun@1.3.9",
  "trustedDependencies": [
    "electron",
    "electron-builder",
    "esbuild"
  ],
  "build": {
    "appId": "com.fuadnafiz.bettercodediff",
    "productName": "Better Code Diff",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@vscode/ripgrep/bin/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Better Code Diff ${version}",
      "artifactName": "Better-Code-Diff-${version}-${arch}.${ext}"
    }
  },
  "workspaces": [
    "."
  ]
}
